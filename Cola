package callcenter;
import java.util.Iterator;
public class Cola<T> implements Iterable<T>{
        
    private class Nodo{
        T dato;
        Nodo siguiente;
        
        Nodo (T dato){
        this.dato = dato;
        }
        
    
     }
    
    private Nodo inicio;
    private Nodo fin; 
    private int tamanio;
    
    public Cola(){
        inicio = null; 
        fin = null;
        tamanio = 0; 
    }
    
    // final 
    public void enqueue (T dato){
        Nodo nuevo = new Nodo(dato);
        if (empty()){
            inicio = nuevo;
            fin = nuevo;
        } else {
            fin.siguiente = nuevo;
            fin = nuevo; 
        }
        tamanio++;
    }
    // extrae del inicio y lo retorna
    public T dequeue(){
        if (empty()){
            throw new RuntimeException("la cola esta vacia");
        }
        T dato = inicio.dato;
        inicio = inicio.siguiente;
        if (inicio == null){
            fin = null;
        }
        tamanio--;
        return dato;
    }
    public T peek(){
        if (empty()){
            throw new RuntimeException ("la cola esta vacia");
        }
        return inicio.dato;
    }
    public boolean empty(){
        return tamanio == 0;
    }
    public int size(){
        return tamanio;
    }
    @Override
    public Iterator <T> iterator(){
        return new Iterator <T>(){
            private Nodo actual = inicio;
            
            @Override
            public boolean hasNext(){
                return actual != null; 
            }
            
            @Override
            public T next(){
                T dato = actual.dato;
                actual = actual.siguiente;
                return dato;
            }
        };
    } 
}
